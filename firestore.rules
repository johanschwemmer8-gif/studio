
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /displays/{displayId} {
      // Allow 'create' if the user is authenticated and the retailerId in the new document
      // matches the retailerId in the user's own profile document.
      allow create: if request.auth != null &&
                       request.resource.data.retailerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.retailerId;
                       
      // By default, deny other operations until explicitly defined.
      allow read, update, delete: if false;
    }

    // Placeholder for other collection rules
    // match /users/{userId} {
    //   ...
    // }
  }
}

{
  "entities": {
    "RetailerConfig": {
      "title": "Retailer Configuration",
      "description": "Tenant-scoped settings for organization and branding.",
      "type": "object",
      "properties": {
        "retailerId": { "type": "string" },
        "type": { "type": "string", "enum": ["org", "brand"] },
        "data": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["retailerId", "type", "data"]
    },
    "PlatformUser": {
      "title": "Platform User",
      "description": "Retailer staff or platform administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "retailerAdmin", "storeManager", "analyst"] },
        "retailerId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "GS1-Aligned Product",
      "description": "Product data keyed by GTIN (Global Trade Item Number).",
      "type": "object",
      "properties": {
        "gtin": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "retailerId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "apple.com", "password", "phone"]
  },
  "firestore": {
    "/configurations/{configId}": {
      "schema": "#/backend/entities/RetailerConfig",
      "description": "Authoritative tenant configuration hub."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/PlatformUser",
      "description": "Management users and staff."
    },
    "/products/{gtin}": {
      "schema": "#/backend/entities/Product",
      "description": "GS1-aligned products keyed by GTIN."
    },
    "/qrcodes/{qrId}": {
      "schema": "object",
      "description": "Master QR code registry."
    },
    "/sessions/{sessionId}": {
      "schema": "object",
      "description": "Shopper journey sessions."
    },
    "/events/{eventId}": {
      "schema": "object",
      "description": "Behavioral event nodes."
    }
  }
}
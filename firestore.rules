
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shoppers manage their own identity and basket
    match /shoppers/{shopperId} {
      allow read, write: if request.auth != null && request.auth.uid == shopperId;
    }

    match /baskets/{id} {
      allow read, write: if request.auth != null && (resource == null || resource.data.shopperId == request.auth.uid || request.resource.data.shopperId == request.auth.uid);
      allow read: if true; // POS Terminals can read basket for syncing
    }

    match /product_interactions/{id} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    match /sessions/{sessionId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update: if request.auth != null && resource.data.shopperId == request.auth.uid;
    }

    match /saved_products/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.shopperId == request.auth.uid || resource.data.shopperId == request.auth.uid);
    }

    match /ai_conversations/{id} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    match /transactions/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Retailer Platform Admin
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Generic fallback for simulation qrcodes/tenants etc
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

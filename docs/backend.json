
{
  "entities": {
    "PlatformUser": {
      "title": "Platform User",
      "description": "Retailer staff or platform administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "retailerAdmin", "storeManager", "analyst"] },
        "retailerId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "ShopperProfile": {
      "title": "Shopper Profile",
      "description": "Persistent identity for a retail customer. The core of the retail memory layer.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "preferences": { "$ref": "#/backend/entities/ShopperPreferences" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "ShopperPreferences": {
      "title": "Shopper Preferences",
      "description": "Personalized settings and categories for a shopper.",
      "type": "object",
      "properties": {
        "categories": { "type": "array", "items": { "type": "string" } },
        "budgetRange": { "type": "string" },
        "aiPersonalityPref": { "type": "string" },
        "marketingConsent": { "type": "boolean" }
      }
    },
    "ShoppingSession": {
      "title": "Shopping Session",
      "description": "A single visit or interaction session initiated by a scan.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "shopperId": { "type": "string" },
        "storeId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "entryQrId": { "type": "string" }
      },
      "required": ["sessionId", "startTime"]
    },
    "ProductInteraction": {
      "title": "Product Interaction",
      "description": "Granular behavioural event tracking for decision intelligence.",
      "type": "object",
      "properties": {
        "interactionId": { "type": "string" },
        "shopperId": { "type": "string" },
        "sessionId": { "type": "string" },
        "productId": { "type": "string" },
        "type": { "type": "string", "enum": ["scan", "comparison", "review_read", "save", "reorder", "tutorial_view", "warranty_activate", "add_to_trolley"] },
        "dwellTime": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["shopperId", "productId", "type", "timestamp"]
    },
    "SavedProduct": {
      "title": "Saved Product",
      "description": "A bookmarked product in a shopper's profile.",
      "type": "object",
      "properties": {
        "shopperId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" },
        "reminderSet": { "type": "boolean" }
      },
      "required": ["shopperId", "productId", "savedAt"]
    },
    "AIConversation": {
      "title": "AI Conversation",
      "description": "Transcript and analysis of an AI assistant interaction.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "shopperId": { "type": "string" },
        "productId": { "type": "string" },
        "transcript": { "type": "array", "items": { "type": "object" } },
        "sentiment": { "type": "number" },
        "resolution": { "type": "string" }
      },
      "required": ["conversationId", "productId"]
    },
    "Basket": {
      "title": "Virtual Smart Trolley",
      "description": "A persistent digital basket for in-store shoppers.",
      "type": "object",
      "properties": {
        "basketId": { "type": "string" },
        "shopperId": { "type": "string" },
        "retailerId": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "synced", "paid"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Transaction": {
      "title": "Retail Transaction",
      "description": "A completed sale log for POS reporting.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "shopperId": { "type": "string" },
        "retailerId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "basketId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "apple.com", "password", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/PlatformUser",
      "description": "Management users and staff."
    },
    "/shoppers/{shopperId}": {
      "schema": "#/backend/entities/ShopperProfile",
      "description": "Customer persistent profiles."
    },
    "/sessions/{sessionId}": {
      "schema": "#/backend/entities/ShoppingSession",
      "description": "Active and past shopper sessions."
    },
    "/product_interactions/{id}": {
      "schema": "#/backend/entities/ProductInteraction",
      "description": "Individual interaction log."
    },
    "/saved_products/{id}": {
      "schema": "#/backend/entities/SavedProduct",
      "description": "Cross-user saved items."
    },
    "/ai_conversations/{id}": {
      "schema": "#/backend/entities/AIConversation",
      "description": "Detailed chat transcripts."
    },
    "/baskets/{id}": {
      "schema": "#/backend/entities/Basket",
      "description": "Digital trolleys."
    },
    "/transactions/{id}": {
      "schema": "#/backend/entities/Transaction",
      "description": "Completed sales records."
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Platform Users: Admins can manage all, users can read their own
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Shoppers: Only the shopper can read/write their own identity and preferences
    match /shoppers/{shopperId} {
      allow read, write: if request.auth != null && request.auth.uid == shopperId;
    }

    // Sessions: Created by shoppers, readable by retailer analytics
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if true; // Guest sessions allowed
      allow update: if request.auth != null && resource.data.shopperId == request.auth.uid;
    }

    // Product Interactions: Create-only for shoppers, read-only for analysts
    match /product_interactions/{id} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Saved Products: Shoppers can manage their own, analysts can list
    match /saved_products/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.shopperId == request.auth.uid || resource.data.shopperId == request.auth.uid);
    }

    // AI Conversations: Transcription logging
    match /ai_conversations/{id} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Campaigns & Retail Media: Publicly readable, admin manageable
    match /campaigns/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /retail_media/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Store Analytics: Read-only for authenticated retailers
    match /store_analytics/{id} {
      allow read: if request.auth != null;
      allow write: if false; // Managed by backend processes only
    }

    // LEGACY PATHS (For backwards compatibility during migration)
    match /qrcodes/{qrId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /bulkQrRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    match /adCampaigns/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /adMetrics/{id} {
      allow create: if true;
      allow read: if false;
    }
  }
}

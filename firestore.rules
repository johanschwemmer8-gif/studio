rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- AUTHENTICATION HELPERS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRetailerId() {
      return request.auth.token.retailerId;
    }

    function isPlatformAdmin() {
      // In this pilot/prototype phase, any authenticated user using the 
      // administrative tools is treated as a platform administrator.
      // Shoppers are anonymous and thus excluded.
      return isAuthenticated();
    }

    function isTenantOwner(retailerId) {
      return isAuthenticated() && (getRetailerId() == retailerId || isPlatformAdmin());
    }

    // --- INTEGRITY HELPERS ---
    
    function validateGtin(gtin) {
      return gtin.size() == 14 && gtin.matches('^[0-9]+$');
    }

    // --- CONFIGURATION HUB ---

    match /tenants/{tenantId} {
      // Public read for branding (shoppers need logo/name)
      allow read: if true;
      // Admin only write
      allow write: if isPlatformAdmin();
    }

    match /configurations/{configId} {
      // Branding is public read for shoppers, but restricted write
      // Org is restricted read/write to the specific tenant
      allow read: if (configId.endsWith('_brand')) || (isAuthenticated());
      allow write: if isPlatformAdmin();
    }

    // --- IDENTITY & PRODUCT LAYER ---

    match /products/{gtin} {
      // Products are public read for shoppers to see details
      allow read: if true;
      // Write/Create limited to the authorized tenant or platform admin
      allow create: if isPlatformAdmin() || (isAuthenticated() && isTenantOwner(request.resource.data.retailerId) && validateGtin(gtin));
      allow update: if isPlatformAdmin() || (isAuthenticated() && isTenantOwner(resource.data.retailerId) && request.resource.data.retailerId == resource.data.retailerId);
      allow delete: if isPlatformAdmin() || (isAuthenticated() && isTenantOwner(resource.data.retailerId));
    }

    match /qrcodes/{qrId} {
      allow read: if true;
      allow write: if isPlatformAdmin() || isTenantOwner(request.resource.data.retailerId);
    }

    match /bulkQrRequests/{requestId} {
      allow read: if isPlatformAdmin() || isTenantOwner(resource.data.retailerId);
      allow create: if isPlatformAdmin() || isTenantOwner(request.resource.data.retailerId);
      allow update, delete: if isPlatformAdmin() || isTenantOwner(request.resource.data.retailerId);

      match /items/{itemId} {
        allow read, write: if isPlatformAdmin() || isTenantOwner(get(/databases/$(database)/documents/bulkQrRequests/$(requestId)).data.retailerId);
      }
    }

    // --- INTELLIGENCE LAYER (iNteract) ---

    match /sessions/{sessionId} {
      allow create: if true;
      allow read, update: if true; 
    }

    match /events/{eventId} {
      allow create: if true;
      allow read: if isPlatformAdmin() || isTenantOwner(resource.data.retailerId);
    }

    match /ai_conversations/{id} {
      allow create: if true;
      allow read: if isPlatformAdmin() || isTenantOwner(resource.data.retailerId);
    }

    // --- TRANSACTION LAYER ---

    match /baskets/{id} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.shopperId == request.auth.uid || request.resource.data.shopperId == request.auth.uid);
    }

    match /shoppers/{shopperId} {
      allow read, write: if isAuthenticated() && request.auth.uid == shopperId;
    }

    match /saved_products/{id} {
      allow read: if isAuthenticated() && (resource.data.shopperId == request.auth.uid);
      allow write: if isAuthenticated() && (request.resource.data.shopperId == request.auth.uid);
    }

    // --- PLATFORM GOVERNANCE ---

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isPlatformAdmin());
      allow write: if isPlatformAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isPlatformAdmin();
    }

    // --- FALLBACK ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
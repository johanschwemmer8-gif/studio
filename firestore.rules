
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Infrastructure Layer: Shoppers can only manage their own data
    match /shoppers/{shopperId} {
      allow read, write: if request.auth != null && request.auth.uid == shopperId;
    }

    // Interaction History: Shoppers create their own events, retailers read aggregated
    match /product_interactions/{id} {
      allow create: if true; // Guest logging allowed
      allow read: if request.auth != null;
    }

    match /sessions/{sessionId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update: if request.auth != null && resource.data.shopperId == request.auth.uid;
    }

    match /saved_products/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.shopperId == request.auth.uid || resource.data.shopperId == request.auth.uid);
    }

    match /ai_conversations/{id} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Platform Administration
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Decision Intelligence Infrastructure: Read-only for retailers
    match /store_analytics/{id} {
      allow read: if request.auth != null;
      allow write: if false; 
    }

    match /campaigns/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /retail_media/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Legacy support
    match /qrcodes/{qrId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

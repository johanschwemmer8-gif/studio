
{
  "entities": {
    "PlatformUser": {
      "title": "Platform User",
      "description": "Retailer staff or platform administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "retailerAdmin", "storeManager", "analyst"] },
        "retailerId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "GS1 Compliant Product",
      "description": "Product data keyed by GTIN.",
      "type": "object",
      "properties": {
        "gtin": { "type": "string", "description": "14-digit Global Trade Item Number (Primary Key)" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "batchNumber": { "type": "string", "description": "Optional GS1 AI 10" },
        "serialNumber": { "type": "string", "description": "Optional GS1 AI 21" },
        "gs1DigitalLink": { "type": "string" },
        "imageUrl": { "type": "string" },
        "retailerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gtin", "name", "price", "retailerId"]
    },
    "ShopperProfile": {
      "title": "Shopper Profile",
      "description": "Persistent identity for a retail customer.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "ShoppingSession": {
      "title": "Shopping Session",
      "description": "A single visit initiated by a GS1 scan.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "shopperId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "entryGtin": { "type": "string" }
      }
    },
    "ProductInteraction": {
      "title": "Behavioural Event",
      "description": "GS1-compliant granular behavioural event.",
      "type": "object",
      "properties": {
        "interactionId": { "type": "string" },
        "shopperId": { "type": "string" },
        "sessionId": { "type": "string" },
        "gtin": { "type": "string" },
        "type": { "type": "string", "enum": ["scan", "comparison", "review_read", "save", "reorder", "add_to_trolley"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "default": "GS1" }
      },
      "required": ["gtin", "type", "timestamp"]
    },
    "Basket": {
      "title": "Virtual Smart Trolley",
      "description": "GTIN-based digital trolley.",
      "type": "object",
      "properties": {
        "basketId": { "type": "string" },
        "shopperId": { "type": "string" },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "gtin": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" }
            }
          } 
        },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "synced", "paid"] }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "apple.com", "password", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/PlatformUser",
      "description": "Management users and staff."
    },
    "/products/{gtin}": {
      "schema": "#/backend/entities/Product",
      "description": "GS1 Products keyed by GTIN."
    },
    "/shoppers/{shopperId}": {
      "schema": "#/backend/entities/ShopperProfile",
      "description": "Customer profiles."
    },
    "/sessions/{sessionId}": {
      "schema": "#/backend/entities/ShoppingSession",
      "description": "Active sessions."
    },
    "/product_interactions/{id}": {
      "schema": "#/backend/entities/ProductInteraction",
      "description": "Granular interaction logs."
    },
    "/baskets/{id}": {
      "schema": "#/backend/entities/Basket",
      "description": "Digital trolleys using GTINs."
    }
  }
}


{
  "entities": {
    "ShopperProfile": {
      "title": "Shopper Profile",
      "description": "A persistent identity for a retail customer across stores and sessions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The Firebase Auth UID." },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "displayName": { "type": "string" },
        "preferences": {
          "type": "object",
          "properties": {
            "categories": { "type": "array", "items": { "type": "string" } },
            "budgetRange": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "InteractionEvent": {
      "title": "Interaction Event",
      "description": "A specific behavioural data point captured during a shopping session.",
      "type": "object",
      "properties": {
        "shopperId": { "type": "string" },
        "productId": { "type": "string" },
        "retailerId": { "type": "string" },
        "eventType": { "type": "string", "enum": ["scan", "chat_query", "save", "comparison_view", "review_read", "ad_click", "ad_impression"] },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["shopperId", "productId", "eventType", "timestamp"]
    },
    "SavedProduct": {
      "title": "Saved Product",
      "description": "A product the user has added to their persistent shopping profile.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "retailerId": { "type": "string" },
        "productName": { "type": "string" },
        "price": { "type": "number" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "savedAt"]
    },
    "AdCampaign": {
      "title": "Retail Media Ad Campaign",
      "description": "A supplier-funded campaign for sponsored placements.",
      "type": "object",
      "properties": {
        "campaignId": { "type": "string" },
        "supplierBrand": { "type": "string" },
        "budget": { "type": "number" },
        "cpm": { "type": "number" },
        "targetCategories": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] },
        "metrics": {
          "type": "object",
          "properties": {
            "impressions": { "type": "number" },
            "clicks": { "type": "number" },
            "conversions": { "type": "number" }
          }
        }
      },
      "required": ["campaignId", "supplierBrand", "status"]
    }
  },
  "auth": {
    "providers": ["google.com", "apple.com", "password", "phone"]
  },
  "firestore": {
    "/shoppers/{shopperId}": {
      "schema": "#/backend/entities/ShopperProfile",
      "description": "Root profile for a shopper."
    },
    "/shoppers/{shopperId}/interactions/{eventId}": {
      "schema": "#/backend/entities/InteractionEvent",
      "description": "Detailed behavioral history for personalization."
    },
    "/shoppers/{shopperId}/savedProducts/{productId}": {
      "schema": "#/backend/entities/SavedProduct",
      "description": "The shopper's persistent wish-list/basket across sessions."
    },
    "/adCampaigns/{campaignId}": {
      "schema": "#/backend/entities/AdCampaign",
      "description": "Media network ad campaigns."
    }
  }
}


{
  "entities": {
    "PlatformUser": {
      "title": "Platform User",
      "description": "Retailer staff or platform administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "retailerAdmin", "storeManager", "analyst"] },
        "retailerId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "GS1-Aligned Product",
      "description": "Product data keyed by GTIN (Global Trade Item Number).",
      "type": "object",
      "properties": {
        "gtin": { "type": "string", "description": "14-digit Global Trade Item Number (Canonical Identifier)" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "batchNumber": { "type": "string", "description": "GS1 AI 10 support" },
        "serialNumber": { "type": "string", "description": "GS1 AI 21 support" },
        "gs1DigitalLink": { "type": "string", "description": "Canonical Digital Link URI" },
        "imageUrl": { "type": "string" },
        "retailerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gtin", "name", "price", "retailerId"]
    },
    "ShopperProfile": {
      "title": "Shopper Profile",
      "description": "Persistent identity for a retail customer.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "ShoppingSession": {
      "title": "iNteract Session",
      "description": "A single behavioural window initiated by a GS1 resolution.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "shopperId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "entryGtin": { "type": "string" },
        "storeId": { "type": "string" }
      }
    },
    "BehaviouralEvent": {
      "title": "Behavioural Event",
      "description": "Granular interaction logged within a session context.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "sessionId": { "type": "string", "description": "Primary session anchor" },
        "eventType": { "type": "string", "enum": ["scan", "view", "add_to_cart", "checkout", "chat_interaction"] },
        "gtin": { "type": "string", "description": "Product dimension" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["sessionId", "eventType", "timestamp"]
    },
    "Basket": {
      "title": "Transaction Layer Basket",
      "description": "Digital trolley using GTIN-based dimensions.",
      "type": "object",
      "properties": {
        "basketId": { "type": "string" },
        "shopperId": { "type": "string" },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "gtin": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" }
            }
          } 
        },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "synced", "paid"] }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "apple.com", "password", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/PlatformUser",
      "description": "Management users and staff."
    },
    "/products/{gtin}": {
      "schema": "#/backend/entities/Product",
      "description": "GS1-aligned products keyed by GTIN."
    },
    "/shoppers/{shopperId}": {
      "schema": "#/backend/entities/ShopperProfile",
      "description": "Customer profiles."
    },
    "/sessions/{sessionId}": {
      "schema": "#/backend/entities/ShoppingSession",
      "description": "Intelligence Layer sessions."
    },
    "/events/{eventId}": {
      "schema": "#/backend/entities/BehaviouralEvent",
      "description": "Session-anchored behavioural events."
    },
    "/baskets/{id}": {
      "schema": "#/backend/entities/Basket",
      "description": "Transaction Layer trolleys."
    }
  }
}

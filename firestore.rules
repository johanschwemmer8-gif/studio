
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- INTEGRITY HELPERS ---
    
    function validateGtin(gtin) {
      return gtin.size() == 14 && gtin.matches('^[0-9]+$');
    }

    function isPlatformAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- IDENTITY LAYER (GS1) ---

    match /products/{gtin} {
      allow read: if true;
      allow write: if isPlatformAdmin() && validateGtin(gtin);
    }

    // --- INTELLIGENCE LAYER (iNteract) ---

    match /sessions/{sessionId} {
      allow create: if true;
      allow read, update: if request.auth != null && (resource == null || resource.data.shopperId == request.auth.uid);
    }

    match /events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null;
      // Ensure all events follow session-first architecture
      allow create: if request.resource.data.sessionId != null && request.resource.data.gtin != null;
    }

    match /ai_conversations/{id} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // --- TRANSACTION LAYER ---

    match /baskets/{id} {
      allow read, write: if request.auth != null && (resource == null || resource.data.shopperId == request.auth.uid || request.resource.data.shopperId == request.auth.uid);
      allow read: if true; // Terminals read basket via GLN handshake
    }

    match /shoppers/{shopperId} {
      allow read, write: if request.auth != null && request.auth.uid == shopperId;
    }

    match /saved_products/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.shopperId == request.auth.uid || resource.data.shopperId == request.auth.uid);
    }

    // --- PLATFORM GOVERNANCE ---

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());
      allow write: if isPlatformAdmin();
    }

    // --- FALLBACK ---
    // STRICT PILOT HARDENING: Fail closed for any path not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

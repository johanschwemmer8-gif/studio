
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shopper Profile Rules
    match /shoppers/{shopperId} {
      allow read, write: if request.auth != null && request.auth.uid == shopperId;
      
      match /interactions/{eventId} {
        allow read, create: if request.auth != null && request.auth.uid == shopperId;
      }
      
      match /savedProducts/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == shopperId;
      }
    }

    // Existing Retailer Admin Rules
    match /displays/{displayId} {
      allow create: if request.auth != null &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.retailerId != null;
      allow read, update, delete: if false; // Placeholder
    }
    
    match /bulkQrRequests/{requestId} {
      allow read, write: if request.auth != null; // Refine based on retailerId claims
    }

    match /qrcodes/{qrId} {
      allow read: if true; // Publicly scannable
      allow write: if request.auth != null;
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tenants/{tenantId} {
      allow read: if true;
    }
  }
}

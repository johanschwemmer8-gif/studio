rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /retailer-assets/{retailerId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.uid == request.auth.uid
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.retailerId == retailerId
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.isActive == true;
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shopper Profile Rules: Only the shopper can read/write their own identity and memory.
    match /shoppers/{shopperId} {
      allow read, write: if request.auth != null && request.auth.uid == shopperId;
      
      match /interactions/{eventId} {
        allow read, create: if request.auth != null && request.auth.uid == shopperId;
      }
      
      match /savedProducts/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == shopperId;
      }
    }

    // Ad Campaigns: Publicly readable for shoppers (to display ads), 
    // but only authenticated retailer admins can write (manage campaigns).
    match /adCampaigns/{campaignId} {
      allow read: if true; // Shoppers need to read ads to see them
      allow write: if request.auth != null; // Refine in production to check 'retailerAdmin' claim
    }

    // Ad Metrics: Create-only for shoppers (to log impressions/clicks).
    // Prevents anyone from reading or tampering with billing data.
    match /adMetrics/{metricId} {
      allow create: if true; // Anyone can log an interaction
      allow read, update, delete: if false; // Only manageable via Admin SDK/Console
    }

    // Platform Core Rules
    match /displays/{displayId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; 
    }
    
    match /bulkQrRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /qrcodes/{qrId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tenants/{tenantId} {
      allow read: if true;
    }
  }
}

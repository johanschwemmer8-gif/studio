rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- INTEGRITY HELPERS ---
    
    function validateGtin(gtin) {
      return gtin.size() == 14 && gtin.matches('^[0-9]+$');
    }

    function isPlatformAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function getRetailerId() {
      return request.auth.token.retailerId;
    }

    // --- CONFIGURATION HUB ---

    match /configurations/{configId} {
      // Branding is public read for shoppers, but restricted write
      // Org is restricted read/write
      allow read: if (configId.endsWith('_brand')) || (request.auth != null && getRetailerId() != null && configId == getRetailerId() + '_org');
      allow write: if request.auth != null && getRetailerId() != null && (configId == getRetailerId() + '_brand' || configId == getRetailerId() + '_org');
    }

    // --- IDENTITY LAYER (GS1) ---

    match /products/{gtin} {
      allow read: if true;
      allow write: if isPlatformAdmin() && validateGtin(gtin);
    }

    match /qrcodes/{qrId} {
      allow read: if true;
      allow write: if request.auth != null && (getRetailerId() == request.resource.data.retailerId || isPlatformAdmin());
    }

    // --- INTELLIGENCE LAYER (iNteract) ---

    match /sessions/{sessionId} {
      allow create: if true;
      allow read, update: if true; // Shoppers need to read session to resolve retailerId for branding
    }

    match /events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null && (getRetailerId() == resource.data.retailerId || isPlatformAdmin());
    }

    match /ai_conversations/{id} {
      allow create: if true;
      allow read: if request.auth != null && (getRetailerId() == resource.data.retailerId || isPlatformAdmin());
    }

    // --- TRANSACTION LAYER ---

    match /baskets/{id} {
      allow read, write: if request.auth != null && (resource == null || resource.data.shopperId == request.auth.uid || request.resource.data.shopperId == request.auth.uid);
    }

    match /shoppers/{shopperId} {
      allow read, write: if request.auth != null && request.auth.uid == shopperId;
    }

    match /saved_products/{id} {
      allow read: if request.auth != null && (resource.data.shopperId == request.auth.uid);
      allow write: if request.auth != null && (request.resource.data.shopperId == request.auth.uid);
    }

    // --- PLATFORM GOVERNANCE ---

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());
      allow write: if isPlatformAdmin();
    }

    // --- FALLBACK ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}